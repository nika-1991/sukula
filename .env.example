# სერვერის პორტი
PORT=3000

# ადმინ-პანელის პაროლი (აუცილებლად შეცვალე!)
ADMIN_PASSWORD=change-me

# სესიის საიდუმლო გასაღები (ნებისმიერი გრძელი შემთხვევითი ტექსტი)
SESSION_SECRET=change-me-to-a-long-random-string

# შეკვეთების შეტყობინება ამ მისამართზე მოვა
ORDER_EMAIL=

# SMTP (იმეილის გასაგზავნად). თუ ცარიელია, შეკვეთები მხოლოდ ბაზაში შეინახება
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
